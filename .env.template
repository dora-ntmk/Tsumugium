# ステータスメッセージ
# 利用可能な変数: {voice_connections}, {voice_users}, {guilds}
STATUS_MESSAGE="{voice_connections}/{guilds}個のVCに接続中"

# DiscordBotのトークン
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# エラー通知を受け取る運営者のDiscordユーザーID（空欄で無効）
OPERATOR_USER_ID=

# データベース
SERVER_CONFIG_DB=db/config.db
DICT_DB=db/dict.db
SOUND_BOARDS_DB=db/soundboards.db

# 絵文字の日本語対応json
EMOJI_JA_JSON=db/emoji_ja.json

# 話者
SPEAKERS_JSON=db/speakers.json
DEFAULT_SPEAKER=8

# 音声の一時出力先ディレクトリ
TMP_DIR=tmp

# VOICEVOXのURL
VOICEVOX_URL=http://127.0.0.1:50021

# バックアップ
BACKUP_DIR=backup
BACKUP_TIMES=10:30
BACKUP_INTERVAL_DAYS=1
BACKUP_KEEP=7
