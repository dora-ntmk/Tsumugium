# Tsumugium の設定ファイルのひな形
#
# 使い方:
#   1. このファイルを .env という名前でコピーする。
#      インストーラーで入れる場合は、展開したディレクトリか /opt/<インスタンス名>/ に置く。
#   2. 下の「必須」の値を書く。
#   3. 値を変えたあとは、Botを再起動する。
#      インストーラーで入れた場合のコマンドは sudo systemctl restart <サービス名>。
#
# 行がない項目は、既定値を使う。

# [必須の設定]

# 必須
# Discord Developer Portal で発行したBotのトークン
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# [任意の設定]

# エラーが起きたときに、DMで知らせる相手のDiscordユーザーID（空欄なら知らせない）
OPERATOR_USER_ID=

# Botのステータスに表示する文（空欄なら表示しない）
# 使える変数: {voice_connections}（接続中のVCの数）、{voice_users}（同じVCにいる人の数）、{guilds}（参加しているサーバーの数）
STATUS_MESSAGE="{voice_connections}/{guilds}個のVCに接続中"

# サーバーで話者を選んでいないときに使うVOICEVOXの話者ID
DEFAULT_SPEAKER=8

# DBのバックアップを取る時刻（カンマ区切りで複数書ける。例: 03:00,15:00）
# 空欄にするとバックアップを取らない
BACKUP_TIMES=12:00
# バックアップを取る間隔（日）
BACKUP_INTERVAL_DAYS=1
# 残すバックアップの数
BACKUP_KEEP=7

# [インストーラーを使わずに手で動かすときだけ使う設定]
# インストーラーで入れた場合は、次の値をsystemdのunitで渡すので、ここに書いても使われない。
# 手で動かすときに既定値から変えたい項目だけ、先頭の # を外して書き換える。

# VOICEVOXのURL
# VOICEVOX_URL=http://127.0.0.1:50021

# データベースの場所
# SERVER_CONFIG_DB=db/config.db
# DICT_DB=db/dict.db
# SOUND_BOARDS_DB=db/soundboards.db
# USER_CONFIG_DB=db/users.db

# 音声の一時ファイルとバックアップの置き場所
# TMP_DIR=tmp
# BACKUP_DIR=backup

# Botに付けて配るデータ（ふつうは変えない）
# EMOJI_JA_JSON=db/emoji_ja.json
# SPEAKERS_JSON=db/speakers.json
